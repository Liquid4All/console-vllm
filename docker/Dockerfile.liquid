# syntax=docker/dockerfile:1
#
# Liquid vLLM image: the upstream release plus Liquid's downstream Python
# patches (currently the LFM2 ShortConv quantization fix).
#
# Every downstream change on liquid/main is pure Python, so we overlay this
# branch's entire vllm Python package onto the official released image instead
# of recompiling any CUDA kernels: it builds in seconds and reuses the exact
# compiled extensions of the base release. Because we copy the whole package
# rather than an enumerated file list, new fixes that touch additional files
# are picked up automatically with no change to this Dockerfile.
#
# NOTE: this only holds while the downstream delta is Python-only. If a patch
# ever touches C/C++/CUDA sources (*.cu/*.cpp/*.cuh), build config, or
# dependencies, the overlay is NOT sufficient and you need a full recompiled
# build instead.
#
# Bump BASE_IMAGE in lockstep with the release this branch is based on.
ARG BASE_IMAGE=vllm/vllm-openai:v0.25.1
FROM ${BASE_IMAGE}

USER root

# Stage this branch's vllm sources. Only *.py files are overlaid below, so a
# stray local build artifact (e.g. a *.so in a dirty working tree) can never
# clobber the image's own compiled extensions.
COPY vllm/ /tmp/liquid-src/vllm/

# Resolve the installed package dir WITHOUT importing vllm/torch: find_spec
# locates the package but doesn't execute it. Importing torch at build time
# fails with an Intel oneMKL error in the GPU-less build sandbox, so the build
# guard is a byte-compile syntax check only; runtime correctness is verified by
# running the image, not here.
RUN set -eux; \
    vllm_dir="$(python3 -c 'import importlib.util as u; print(u.find_spec("vllm").submodule_search_locations[0])')"; \
    cd /tmp/liquid-src/vllm; \
    find . -type f -name '*.py' -print0 | tar --null -cf - -T - | tar -C "${vllm_dir}" -xf -; \
    rm -rf /tmp/liquid-src; \
    python3 -m compileall -q "${vllm_dir}"
